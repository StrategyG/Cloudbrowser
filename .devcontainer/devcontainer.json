{
  "name": "Cloudbrowser CPU-Only Production",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Cloudbrowser private dashboard",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "remoteUser": "vscode"
}
