[Unit]
Description=Cloudbrowser Telegram browser and video agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudbrowser
Group=cloudbrowser
WorkingDirectory=/opt/Cloudbrowser
Environment=CLOUDBROWSER_DATA_DIR=/var/lib/cloudbrowser
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x720x24 -nolisten tcp" /opt/Cloudbrowser/.venv/bin/python -m cloudbrowser serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloudbrowser
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
